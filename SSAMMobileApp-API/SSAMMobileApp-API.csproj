<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Assembly / exe name. Must stay "SSAMMobileApp-API" so the build output is
         SSAMMobileApp-API.exe at the path the AVD admin whitelisted. -->
    <AssemblyName>SSAMMobileApp-API</AssemblyName>
    <!-- A hyphen isn't valid in a C# namespace, so code uses "SSAMMobileApp". -->
    <RootNamespace>SSAMMobileApp</RootNamespace>

    <!-- Enables `dotnet user-secrets` for this project (local secrets only). -->
    <UserSecretsId>49f942aa-e738-430a-8d25-34b17571e8e5</UserSecretsId>

    <!-- Emit XML doc comments so they show up in the OpenAPI document. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591: don't warn about missing XML comments on every public member. -->
    <!-- AV00xx: informational suggestions from the Asp.Versioning analyzer. -->
    <NoWarn>$(NoWarn);1591;AV0016;AV0029;AV0030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

</Project>
